# Public read-only configuration. Never place a private key in NEXT_PUBLIC_*.
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_DEPLOY_BLOCK=0
NEXT_PUBLIC_MOCK_USDC_ADDRESS=
# Server-only IPFS upload backend. Use either a free local Kubo node or a
# free-tier Pinata JWT. Never prefix the JWT with NEXT_PUBLIC_.
IPFS_RPC_URL=http://127.0.0.1:5001
# PINATA_JWT=
# For command-line Sepolia deployment only, provide DEPLOYER_PRIVATE_KEY and
# SEPOLIA_RPC_URL securely in your shell. They are never used by the frontend.
